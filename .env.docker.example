# Copy to .env before `docker compose up`. Never commit .env.

# --- Runtime ---------------------------------------------------------------
# development: DEBUG on, demo seeding allowed.
# production : DEBUG off, requires a real SECRET_KEY and DB_PASSWORD.
DJANGO_ENV=development
DEBUG=True

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-local-docker-only

# Hostnames served by nginx. Add your server name or LAN IP for remote access.
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Ports on the host -----------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- PostgreSQL ------------------------------------------------------------
DB_NAME=didebaan_aml
DB_USER=didebaan
DB_PASSWORD=didebaan_local_password

# --- Celery worker ---------------------------------------------------------
CELERY_CONCURRENCY=2

# --- Console build ---------------------------------------------------------
# "production" hides the development badge in the console header.
VITE_ENVIRONMENT=production

# --- Production only -------------------------------------------------------
# Terminate TLS at a reverse proxy in front of this stack, then set USE_HTTPS=True.
USE_HTTPS=False
# AML_ALERT_SLA_HOURS=24
